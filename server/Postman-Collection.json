          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userQuery\": \"Find flights to New York for next week\",\n  \"screenshot\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAUA\",\n  \"domString\": \"<html><body><div class='search-box'><input type='text' id='search' placeholder='Search flights'/><button class='search-btn'>Search</button></div></body></html>\",\n  \"previousMessages\": [],\n  \"sitemap\": \"Home > Flights > Search > Results\"\n}"
        },
        "url": {
          "raw": "http://localhost:8787/analyze",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8787",
          "path": ["analyze"]
