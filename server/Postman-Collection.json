            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Hello! I found flights to New York for next week. Let me show you the best options.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8787/tts",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8787",
          "path": ["tts"]
        },
        "description": "Convert text to speech using Google Cloud TTS API. Returns MP3 audio file."
