          "raw": "{\n  \"audio_data\": \"data:audio/webm;base64,GkXfo59BE7N8gJBLqoKBQIqBTUDg2ZNZW5jb2RlZCBhdWRpbyBzdHJlYW0gaW4gd2VibyBmb3JtYXQ=\",\n  \"language\": \"en\"\n}"
        },
        "url": {
          "raw": "http://localhost:8787/asr",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8787",
          "path": ["asr"]
        },
        "description": "Convert speech (audio) to text using OpenAI Whisper"
      },
      "response": []
    },
    {
      "name": "ANALYZE - AI Query Analysis",
      "request": {
        "method": "POST",
